{
  "name": "@viva-voz/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@viva-voz/core": "*",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-file-system": "~58.0.11",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "llama.rn": "0.12.9",
    "onnxruntime-react-native": "^1.24.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-audio-api": "^0.13.6",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "fetch-deps": "./scripts/fetch-native-deps.sh",
    "android": "JAVA_HOME=$(/usr/libexec/java_home -v 21) expo run:android",
    "build:debug": "expo prebuild -p android && cd android && JAVA_HOME=$(/usr/libexec/java_home -v 21) ./gradlew app:assembleDebug",
    "build:release": "expo prebuild -p android && cd android && JAVA_HOME=$(/usr/libexec/java_home -v 21) ./gradlew app:assembleRelease",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "eas-build-post-install": "./scripts/eas-post-install.sh",
    "build:aab": "JAVA_HOME=$(/usr/libexec/java_home -v 21) eas build -p android --profile production --local",
    "build:bundle": "ECO_ASSET_PACKS=1 expo prebuild -p android --clean && cd android && ECO_ASSET_PACKS=1 JAVA_HOME=$(/usr/libexec/java_home -v 21) ./gradlew app:bundleRelease"
  },
  "private": true
}
